# Скопируй в .env и заполни. В Coolify те же значения задай в Environment Variables.

# === ТВОЙ вход в панель (это то, чем ты логинишься из интернета) ===
APP_USERNAME=admin
APP_PASSWORD=                      # ОБЯЗАТЕЛЬНО: длинный сложный пароль (16+ символов)

# Постоянный ключ подписи cookie-сессий. Сгенерируй так:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# === Доступ СЕРВЕРА к роутеру (внутри LAN) ===
ROUTER_URL=http://192.168.0.1:8080
ROUTER_USERNAME=admin
ROUTER_PASSWORD=admin

# === Опции ===
COOKIE_SECURE=true                 # true за HTTPS (Coolify). false только для локального http-теста
SESSION_MAX_AGE=28800              # время жизни сессии, сек (8 ч)
RATE_LIMIT_ATTEMPTS=5              # неудачных попыток входа до блокировки
RATE_LIMIT_WINDOW=300              # окно подсчёта попыток, сек
RATE_LIMIT_LOCKOUT=900             # длительность блокировки, сек
ENABLE_RAW_CONSOLE=true            # вкладка «Эксперт» с сырыми запросами к роутеру
